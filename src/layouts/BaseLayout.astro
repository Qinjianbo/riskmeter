---
import '../styles/global.css';
import { alternatePath, alternateUrl, currentWorkflowIndex, localizedText, nav, pagePath, pageUrl, type RiskPage } from '../data/site';

interface Props {
  page: RiskPage;
  rootLanding?: boolean;
}

const { page, rootLanding = false } = Astro.props;
const t = localizedText(page.lang);
const canonical = rootLanding ? 'https://riskmeter.app/' : pageUrl(page);
const currentLangUrl = rootLanding ? 'https://riskmeter.app/en/' : pageUrl(page);
const alternate = rootLanding ? 'https://riskmeter.app/zh/' : alternateUrl(page);
const currentPath = pagePath(page);
const inWorkflow = currentWorkflowIndex(page) >= 0;
const isNavActive = (href: string) => {
  if (href === `/${page.lang}/`) return currentPath === href;
  if (href.endsWith('/drawdown-test/')) return inWorkflow && !currentPath.endsWith('/pendulum/');
  return currentPath === href || currentPath.startsWith(href);
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: page.headline,
  description: page.description,
  url: canonical,
  inLanguage: page.lang,
  isPartOf: {
    '@type': 'WebSite',
    name: 'RiskMeter',
    url: 'https://riskmeter.app/'
  },
  publisher: {
    '@type': 'Organization',
    name: 'RiskMeter'
  }
};
---

<!doctype html>
<html lang={page.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={page.lang} href={currentLangUrl} />
    <link rel="alternate" hreflang={page.lang === 'en' ? 'zh' : 'en'} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={rootLanding ? 'https://riskmeter.app/' : page.lang === 'en' ? canonical : alternate} />
    <link rel="sitemap" href="https://riskmeter.app/sitemap.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen">
    <div class="fixed inset-x-0 top-0 z-40 border-b border-black/10 bg-white/90 backdrop-blur-xl">
      <header class="mx-auto flex max-w-7xl items-center gap-3 px-3 py-3 sm:px-6">
        <a class="focus-ring flex items-center gap-3 rounded-xl" href={`/${page.lang}/`} aria-label="RiskMeter">
          <span class="grid h-9 w-9 place-items-center rounded-xl bg-ink text-sm font-black text-white">RM</span>
          <span class="shrink-0 leading-tight">
            <span class="block text-sm font-black tracking-wide text-ink">RiskMeter</span>
            <span class="hidden text-xs font-semibold text-muted sm:block">Measure Risk. Stay Rational.</span>
          </span>
        </a>
        <nav class="flex min-w-0 flex-1 gap-1 overflow-x-auto px-1 sm:justify-center sm:gap-2" aria-label="Primary">
          {nav[page.lang].map((item) => (
            <a
              class:list={[
                'focus-ring shrink-0 rounded-xl px-2.5 py-2 text-xs font-bold transition sm:px-3 sm:text-sm',
                isNavActive(item.href) ? 'bg-ink text-white' : 'text-steel hover:bg-black/5'
              ]}
              href={item.href}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <div class="shrink-0">
          <a class="focus-ring rounded-xl border border-black/10 bg-white px-3 py-2 text-sm font-bold text-steel shadow-sm hover:bg-mist" href={alternatePath(page)} data-lang-switch={page.lang === 'en' ? 'zh' : 'en'}>
            {t.switchLanguage}
          </a>
        </div>
      </header>
    </div>

    <main class="pt-16">
      <slot />
    </main>

    <footer class="mt-20 border-t border-black/10 bg-white">
      <div class="mx-auto grid max-w-7xl gap-8 px-4 py-10 sm:px-6 lg:grid-cols-[1fr_2fr]">
        <div>
          <div class="text-lg font-black text-ink">RiskMeter</div>
          <p class="mt-3 max-w-md text-sm leading-7 text-muted">{t.localOnly}</p>
        </div>
        <div class="grid gap-3 text-sm font-semibold text-steel sm:grid-cols-3">
          <a class="focus-ring rounded-lg py-1 hover:text-aqua" href={`/${page.lang}/about/`}>{page.lang === 'en' ? 'About' : '关于'}</a>
          <a class="focus-ring rounded-lg py-1 hover:text-aqua" href={`/${page.lang}/ethics/`}>{page.lang === 'en' ? 'Ethics' : '伦理守则'}</a>
          <a class="focus-ring rounded-lg py-1 hover:text-aqua" href={`/${page.lang}/sitemap/`}>{page.lang === 'en' ? 'Sitemap' : '站点地图'}</a>
        </div>
      </div>
    </footer>

    <script>
      document.querySelectorAll('[data-lang-switch]').forEach((link) => {
        link.addEventListener('click', () => {
          localStorage.setItem('rm_lang', link.getAttribute('data-lang-switch') || 'en');
        });
      });
    </script>
  </body>
</html>

---
import type { RiskPage } from '../data/site';

interface Props {
  page: RiskPage;
}

const { page } = Astro.props;
---

{page.sections?.length ? (
  <div class="mx-auto mt-12 grid max-w-7xl gap-8 px-4 sm:px-6">
    {page.sections.map((section) => (
      <section class="rounded-3xl border border-black/10 bg-white p-6 shadow-soft sm:p-8">
        <div class="max-w-3xl">
          <h2 class="text-2xl font-black text-ink">{section.title}</h2>
          {section.body && <p class="mt-3 text-base leading-8 text-muted">{section.body}</p>}
        </div>
        {section.items?.length && (
          <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {section.items.map((item) => (
              <article id={item.id} class="rounded-2xl border border-black/10 bg-mist/45 p-5">
                <h3 class="text-base font-black text-ink">{item.title}</h3>
                <p class="mt-2 text-sm leading-7 text-muted">{item.body}</p>
                {item.href && <a class="mt-3 inline-flex text-sm font-black text-aqua" href={item.href}>{page.lang === 'en' ? 'Open' : '打开'}</a>}
              </article>
            ))}
          </div>
        )}
      </section>
    ))}
  </div>
) : null}

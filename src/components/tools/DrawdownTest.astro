---
import type { RiskPage } from '../../data/site';

interface Props {
  page: RiskPage;
}

const { page } = Astro.props;
const zh = page.lang === 'zh';
---

<section class="mx-auto mt-12 max-w-7xl px-4 sm:px-6">
  <div class="grid gap-6 lg:grid-cols-[.95fr_1.05fr]">
    <form class="risk-surface rounded-3xl p-6" data-dd-test>
      <div class="flex flex-col items-start justify-between gap-4 sm:flex-row">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.2em] text-aqua">{zh ? '输入' : 'Inputs'}</p>
          <h2 class="mt-2 text-2xl font-black text-ink">{zh ? '回撤承受度' : 'Drawdown tolerance'}</h2>
        </div>
        <button type="button" class="rounded-2xl border border-black/10 px-4 py-2 text-sm font-black" data-dd-clear>{zh ? '清空' : 'Clear'}</button>
      </div>

      <div class="mt-6 grid gap-5">
        <label class="grid gap-2">
          <span class="tool-label"><span>{zh ? '当前/假设回撤' : 'Current or assumed drawdown'}</span><strong data-dd-label>25%</strong></span>
          <input class="w-full" data-dd-range type="range" min="0" max="80" step="1" value="25" />
          <input class="tool-input" data-dd-input type="number" min="0" max="99" step="1" value="25" />
        </label>
        <label class="grid gap-2">
          <span class="tool-label"><span>{zh ? '组合规模' : 'Portfolio value'}</span></span>
          <input class="tool-input" data-portfolio type="number" min="0" step="1000" value="100000" />
        </label>
        <label class="grid gap-2">
          <span class="tool-label"><span>{zh ? '情景笔记' : 'Scenario note'}</span><span>{zh ? '最多 40 字' : '40 chars max'}</span></span>
          <input class="tool-input" data-note maxlength="40" placeholder={zh ? '例如：如果科技仓位下跌' : 'Example: if tech sleeve falls'} />
        </label>
        <button type="button" class="focus-ring rounded-2xl bg-ink px-5 py-3 text-sm font-black text-white" data-save-scenario>{zh ? '保存情景' : 'Save scenario'}</button>
      </div>
    </form>

    <div class="grid gap-6">
      <div class="rounded-3xl bg-ink p-6 text-white shadow-soft">
        <p class="text-xs font-black uppercase tracking-[0.2em] text-aqua">{zh ? '结果' : 'Result'}</p>
        <div class="mt-5 grid gap-4 sm:grid-cols-3">
          <div>
            <div class="text-sm text-white/60">{zh ? '风险档位' : 'Band'}</div>
            <div class="mt-1 text-2xl font-black" data-dd-band>Moderate</div>
          </div>
          <div>
            <div class="text-sm text-white/60">{zh ? '账面亏损' : 'Loss'}</div>
            <div class="mt-1 text-2xl font-black text-ember" data-dd-loss>-$25,000</div>
          </div>
          <div>
            <div class="text-sm text-white/60">{zh ? '回本所需涨幅' : 'Recovery gain'}</div>
            <div class="mt-1 text-2xl font-black text-aqua" data-dd-recovery>33.3%</div>
          </div>
        </div>
        <p class="mt-5 text-sm leading-7 text-white/70" data-dd-summary></p>
      </div>
      <div class="rounded-3xl border border-black/10 bg-white p-6 shadow-soft">
        <h2 class="text-xl font-black text-ink">{zh ? '保存的情景' : 'Saved scenarios'}</h2>
        <div class="mt-4 grid gap-3" data-scenarios></div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ zh }}>
  (() => {
    const root = document.querySelector('[data-dd-test]');
    if (!root) return;
    const stateKey = 'rm_drawdown_state';
    const scenariosKey = 'rm_drawdown_scenarios';
    const fmtCurrency = (value) => new Intl.NumberFormat(zh ? 'zh-CN' : 'en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(value || 0);
    const bands = zh
      ? [[10, '极低'], [15, '低'], [25, '中等'], [35, '高'], [100, '极高']]
      : [[10, 'Very low'], [15, 'Low'], [25, 'Moderate'], [35, 'High'], [100, 'Very high']];
    const el = {
      range: document.querySelector('[data-dd-range]'),
      input: document.querySelector('[data-dd-input]'),
      portfolio: document.querySelector('[data-portfolio]'),
      label: document.querySelector('[data-dd-label]'),
      band: document.querySelector('[data-dd-band]'),
      loss: document.querySelector('[data-dd-loss]'),
      recovery: document.querySelector('[data-dd-recovery]'),
      summary: document.querySelector('[data-dd-summary]'),
      note: document.querySelector('[data-note]'),
      scenarios: document.querySelector('[data-scenarios]')
    };
    const clamp = (value, max = 99) => Math.min(max, Math.max(0, Number(value) || 0));
    const getState = () => ({ drawdown: clamp(el.input.value), portfolio: Math.max(0, Number(el.portfolio.value) || 0) });
    const save = () => localStorage.setItem(stateKey, JSON.stringify(getState()));
    const recovery = (dd) => dd >= 99 ? 0 : ((1 / (1 - dd / 100)) - 1) * 100;
    const bandFor = (dd) => bands.find(([max]) => dd <= max)?.[1] || bands[bands.length - 1][1];
    const renderScenarios = () => {
      let list = [];
      try { list = JSON.parse(localStorage.getItem(scenariosKey) || '[]') || []; } catch (_) {}
      el.scenarios.innerHTML = list.length ? '' : `<p class="text-sm text-muted">${zh ? '暂无保存情景。' : 'No saved scenarios yet.'}</p>`;
      list.forEach((item) => {
        const node = document.createElement('button');
        node.type = 'button';
        node.className = 'rounded-2xl border border-black/10 bg-mist/50 p-4 text-left hover:border-aqua/50';
        node.innerHTML = `<strong class="block text-ink">${bandFor(item.drawdown)} · ${item.drawdown}%</strong><span class="block text-sm leading-7 text-muted">${fmtCurrency(item.portfolio)} · ${item.note || ''}</span>`;
        node.addEventListener('click', () => {
          el.input.value = item.drawdown;
          el.range.value = item.drawdown;
          el.portfolio.value = item.portfolio;
          update();
        });
        el.scenarios.appendChild(node);
      });
    };
    const update = () => {
      const state = getState();
      el.input.value = state.drawdown;
      el.range.value = state.drawdown;
      el.label.textContent = `${state.drawdown}%`;
      el.band.textContent = bandFor(state.drawdown);
      el.loss.textContent = state.portfolio > 0 ? `-${fmtCurrency(state.portfolio * state.drawdown / 100)}` : '—';
      el.recovery.textContent = `${recovery(state.drawdown).toFixed(1)}%`;
      el.summary.textContent = zh
        ? `${state.drawdown}% 回撤属于「${bandFor(state.drawdown)}」档，回本需要约 ${recovery(state.drawdown).toFixed(1)}% 的涨幅。`
        : `${state.drawdown}% drawdown is in the ${bandFor(state.drawdown)} band and needs about ${recovery(state.drawdown).toFixed(1)}% to recover.`;
      save();
    };
    try {
      const saved = JSON.parse(localStorage.getItem(stateKey) || '{}');
      if (typeof saved.drawdown === 'number') el.input.value = el.range.value = saved.drawdown;
      if (typeof saved.portfolio === 'number') el.portfolio.value = saved.portfolio;
    } catch (_) {}
    [el.range, el.input, el.portfolio].forEach((node) => node.addEventListener('input', update));
    document.querySelector('[data-save-scenario]').addEventListener('click', () => {
      let list = [];
      try { list = JSON.parse(localStorage.getItem(scenariosKey) || '[]') || []; } catch (_) {}
      list = [...list, { ...getState(), note: String(el.note.value || '').trim().slice(0, 40), ts: Date.now() }].slice(-3);
      localStorage.setItem(scenariosKey, JSON.stringify(list));
      el.note.value = '';
      renderScenarios();
    });
    document.querySelector('[data-dd-clear]').addEventListener('click', () => {
      localStorage.removeItem(stateKey);
      localStorage.removeItem(scenariosKey);
      el.input.value = el.range.value = 25;
      el.portfolio.value = 100000;
      update();
      renderScenarios();
    });
    update();
    renderScenarios();
  })();
</script>

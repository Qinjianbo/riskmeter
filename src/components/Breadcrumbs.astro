---
import { breadcrumbs, type RiskPage } from '../data/site';

interface Props {
  page: RiskPage;
}

const { page } = Astro.props;
const items = breadcrumbs(page);
---

{items.length ? (
  <nav class="mx-auto max-w-7xl px-4 pb-3 pt-5 text-sm font-bold text-muted sm:px-6" aria-label="Breadcrumb">
    <ol class="flex min-w-0 flex-wrap items-center gap-2">
      {items.map((item, index) => (
        <li class="flex min-w-0 items-center gap-2">
          {index > 0 && <span class="text-black/25">/</span>}
          {index === items.length - 1 ? (
            <span class="max-w-[18rem] truncate text-ink">{item.label}</span>
          ) : (
            <a class="focus-ring rounded-lg hover:text-aqua" href={item.href}>{item.label}</a>
          )}
        </li>
      ))}
    </ol>
  </nav>
) : null}

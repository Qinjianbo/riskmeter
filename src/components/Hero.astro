---
import type { RiskPage } from '../data/site';

interface Props {
  page: RiskPage;
}

const { page } = Astro.props;
---

<section class="relative overflow-hidden border-b border-black/10 bg-ink text-white">
  <div class="absolute inset-0">
    <img src="/assets/risk-dashboard-hero.png" alt="" class="h-full w-full object-cover opacity-55" />
    <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/82 to-ink/28"></div>
  </div>
  <div class="relative mx-auto grid min-h-[520px] max-w-7xl items-end gap-10 px-4 pb-12 pt-20 sm:px-6 lg:grid-cols-[1.1fr_.9fr] lg:pb-16">
    <div class="w-full max-w-[calc(100vw-2rem)] sm:max-w-none">
      <p class="mb-5 inline-flex rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-black uppercase tracking-[0.22em] text-aqua">
        {page.eyebrow}
      </p>
      <h1 class="max-w-[11ch] break-words text-4xl font-black leading-[1.02] tracking-normal sm:max-w-4xl sm:text-6xl lg:text-7xl">{page.headline}</h1>
      <p class="mt-6 max-w-full text-lg leading-8 text-white/78 sm:max-w-2xl">{page.summary}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        {page.primaryCta && (
          <a class="focus-ring w-full rounded-2xl bg-aqua px-5 py-3 text-center text-sm font-black text-ink shadow-lg shadow-aqua/20 hover:bg-white sm:w-auto" href={page.primaryCta.href}>{page.primaryCta.label}</a>
        )}
        {page.secondaryCtas?.slice(0, 2).map((cta) => (
          <a class="focus-ring w-full rounded-2xl border border-white/15 bg-white/10 px-5 py-3 text-center text-sm font-black text-white hover:bg-white/18 sm:w-auto" href={cta.href}>{cta.label}</a>
        ))}
      </div>
    </div>
    <div class="risk-surface hidden rounded-3xl p-4 text-ink lg:block">
      <div class="grid gap-3">
        {(page.metrics ?? [
          { label: page.lang === 'en' ? 'Risk posture' : '风险姿态', value: page.lang === 'en' ? 'Visible' : '可见', tone: 'aqua' },
          { label: page.lang === 'en' ? 'Assumptions' : '假设', value: page.lang === 'en' ? 'Explicit' : '明确', tone: 'leaf' },
          { label: page.lang === 'en' ? 'Advice' : '建议属性', value: page.lang === 'en' ? 'None' : '无', tone: 'amber' }
        ]).map((metric) => (
          <div class="rounded-2xl border border-black/10 bg-white p-5">
            <div class="text-xs font-black uppercase tracking-[0.18em] text-muted">{metric.label}</div>
            <div class:list={[
              'mt-2 text-3xl font-black',
              metric.tone === 'leaf' && 'text-leaf',
              metric.tone === 'amber' && 'text-amber',
              metric.tone === 'ember' && 'text-ember',
              (!metric.tone || metric.tone === 'aqua') && 'text-aqua'
            ]}>{metric.value}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

---
import { allPages, pagePath, type RiskPage } from '../data/site';

interface Props {
  page: RiskPage;
}

const { page } = Astro.props;
const pages = allPages.filter((item) => item.lang === page.lang);
---

<section class="mx-auto mt-12 max-w-7xl px-4 sm:px-6">
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {pages.map((item) => (
      <a class="focus-ring rounded-3xl border border-black/10 bg-white p-5 shadow-soft transition hover:-translate-y-1 hover:border-aqua/40" href={pagePath(item)}>
        <p class="text-xs font-black uppercase tracking-[0.18em] text-aqua">{item.eyebrow}</p>
        <h2 class="mt-2 text-lg font-black text-ink">{item.headline}</h2>
        <p class="mt-2 text-sm leading-7 text-muted">{item.description}</p>
      </a>
    ))}
  </div>
</section>

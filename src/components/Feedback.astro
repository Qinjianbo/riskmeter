---
import { localizedText, type RiskPage } from '../data/site';

interface Props {
  page: RiskPage;
}

const { page } = Astro.props;
const t = localizedText(page.lang);
---

<section class="mx-auto mt-12 max-w-7xl px-4 sm:px-6">
  <div class="flex flex-col gap-4 rounded-3xl border border-black/10 bg-white p-5 shadow-soft sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="text-lg font-black text-ink">{t.useful}</h2>
      <p class="text-sm leading-7 text-muted">{page.lang === 'en' ? 'Feedback is stored only in this browser.' : '反馈只保存在当前浏览器。'}</p>
    </div>
    <div class="flex gap-3" data-feedback-page={`${page.lang}/${page.slug || 'home'}`}>
      <button class="focus-ring rounded-2xl bg-ink px-4 py-3 text-sm font-black text-white" data-feedback-kind="helpful">{t.yes}</button>
      <button class="focus-ring rounded-2xl border border-black/10 bg-mist px-4 py-3 text-sm font-black text-ink" data-feedback-kind="needsWork">{t.no}</button>
    </div>
  </div>
</section>

<script>
  const signalKey = 'rm_signal_log';
  document.querySelectorAll('[data-feedback-page]').forEach((box) => {
    box.querySelectorAll('[data-feedback-kind]').forEach((button) => {
      button.addEventListener('click', () => {
        const page = box.getAttribute('data-feedback-page') || 'unknown';
        const kind = button.getAttribute('data-feedback-kind') || 'helpful';
        let signals = {};
        try {
          signals = JSON.parse(localStorage.getItem(signalKey) || '{}') || {};
        } catch (_) {
          signals = {};
        }
        const current = signals[page] || { views: 0, helpful: 0, needsWork: 0 };
        current[kind] = (current[kind] || 0) + 1;
        signals[page] = current;
        localStorage.setItem(signalKey, JSON.stringify(signals));
        button.textContent = button.textContent + ' ✓';
      }, { once: true });
    });
  });
</script>
